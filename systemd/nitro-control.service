[Unit]
Description=Safe Acer Nitro fan-control backend
Documentation=https://github.com/nodramaollama/omarchy-nitro-control
After=systemd-modules-load.service

[Service]
Type=simple
User=root
Group=root
Environment=NITRO_CONTROL_GROUP=wheel
Environment=NITRO_CONTROL_UID=1000
Environment=NITRO_CONTROL_MANUAL_TIMEOUT=12
EnvironmentFile=-/etc/nitro-control.conf
ExecStart=/usr/lib/nitro-control/nitro_control.py --group ${NITRO_CONTROL_GROUP} --uid ${NITRO_CONTROL_UID} --manual-timeout ${NITRO_CONTROL_MANUAL_TIMEOUT}
Restart=on-failure
RestartSec=2
RuntimeDirectory=nitro-control
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN
PrivateTmp=yes
PrivateNetwork=yes
ProtectHome=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelLogs=yes
ProtectKernelModules=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
